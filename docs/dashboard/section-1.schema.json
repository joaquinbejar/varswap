{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "solana-projects-dashboard/section/1",
  "title": "One repo's section of the shared read-only dashboard, version 1 (docs/dashboard.md)",
  "type": "object",
  "required": ["schema", "repo", "title", "cluster", "generated_at", "source", "status", "tiles", "series", "tables", "links"],
  "properties": {
    "schema": { "const": "solana-projects-dashboard/section/1" },
    "repo": { "type": "string", "minLength": 1 },
    "title": { "type": "string", "minLength": 1 },
    "cluster": { "type": "string", "minLength": 1 },
    "generated_at": { "$ref": "#/$defs/time" },
    "source": {
      "type": "object",
      "required": ["commit", "slot", "program_ids"],
      "properties": {
        "commit": { "type": "string" },
        "slot": { "type": "integer", "minimum": 0 },
        "program_ids": { "type": "array", "items": { "type": "string" } }
      }
    },
    "status": {
      "type": "object",
      "required": ["level", "message"],
      "properties": {
        "level": { "enum": ["ok", "warn", "stale"] },
        "message": { "type": "string" }
      }
    },
    "tiles": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "label", "value"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "label": { "type": "string" },
          "value": { "type": ["string", "null"] },
          "unit": { "type": "string" },
          "quality": { "type": "string" },
          "note": { "type": "string" }
        }
      }
    },
    "series": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "label", "points"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "label": { "type": "string" },
          "unit": { "type": "string" },
          "points": {
            "type": "array",
            "items": {
              "type": "array",
              "minItems": 2,
              "maxItems": 2,
              "prefixItems": [
                { "$ref": "#/$defs/time" },
                { "oneOf": [{ "$ref": "#/$defs/decimal" }, { "type": "null" }] }
              ]
            }
          },
          "quality": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "tables": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "columns", "rows"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "columns": { "type": "array", "items": { "type": "string" } },
          "rows": {
            "type": "array",
            "items": { "type": "array", "items": { "type": ["string", "null"] } }
          },
          "href_columns": {
            "type": "object",
            "additionalProperties": { "type": "string", "pattern": "^https://[^\\s]*\\{\\}[^\\s]*$" }
          }
        }
      }
    },
    "links": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["label", "href"],
        "properties": {
          "label": { "type": "string" },
          "href": { "$ref": "#/$defs/href" }
        }
      }
    }
  },
  "$defs": {
    "time": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?Z$" },
    "decimal": { "type": "string", "pattern": "^-?[0-9]+(\\.[0-9]+)?$" },
    "href": {
      "type": "string",
      "description": "Absolute https, or a relative path with no scheme, no leading slash or backslash, no backslash at all, no . or .. segment, percent-encoded forms included.",
      "pattern": "^(https://[^\\s\\\\]+|(?![A-Za-z][A-Za-z0-9+.-]*:)(?![/\\\\])(?![^\\s]*\\\\)(?![^\\s]*%(?:2[fF]|5[cC]))(?!(?:[^\\s]*/)?(?:\\.|%2[eE]){1,2}(?:/|$))[^\\s]+)$"
    }
  }
}
